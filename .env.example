# Your Sento workspace's MCP address and the courier connection key. The
# connection needs read+write on "Competitor moves" and "Competitors"
# (coverage write-back), and read on "Competitors".
SENTO_MCP_URL=https://app.yourcompany-sento.com/api/mcp
SENTO_COURIER_KEY=...

# Optional local override so a dry run needs no Sento at all:
# COMPETITORS=Atlan|https://atlan.com,Dust|https://dust.tt

# Optional heartbeat metric entity (daily cadence in the console).
# HEARTBEAT_ENTITY=Competitor watch heartbeat

# Practice mode: logs what WOULD be written, writes nothing.
DRY_RUN=true
POLL_MINUTES=60
